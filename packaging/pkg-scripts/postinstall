#!/bin/sh
# pkg 安装后的依赖检查
set -e

if ! command -v python3 >/dev/null 2>&1; then
    echo "警告：没有找到 python3"
elif ! python3 -c "import requests" >/dev/null 2>&1; then
    echo "警告：缺少 requests，请运行：pip3 install requests --break-system-packages"
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "警告：没有找到 ffmpeg，请运行：brew install ffmpeg"
fi

exit 0
